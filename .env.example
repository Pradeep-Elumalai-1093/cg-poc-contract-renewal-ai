# Choose "anthropic" or "vllm"
LLM_PROVIDER=vllm

# --- Anthropic (only needed if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- vLLM (only needed if LLM_PROVIDER=vllm) ---
# Base URL of your running vLLM OpenAI-compatible server (no trailing slash, no /v1)
VLLM_BASE_URL=http://localhost:8000
# Must exactly match the model name you launched vLLM with
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Only needed if you started vLLM with --api-key
VLLM_API_KEY=
